{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tempo",
  "version": "0.1.0",
  "identifier": "com.eduar.tempo",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3010",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tempo",
        "width": 430,
        "height": 840,
        "visible": false,
        "resizable": true,
        "minWidth": 380,
        "minHeight": 420,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
